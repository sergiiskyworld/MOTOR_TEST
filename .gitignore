# the browser profile the stand window is opened in
Prog/.browser-profile/

# recorded runs
Prog/server/logs/
logs/

# Flash dumps the flashing script takes before every write. These are tool
# output, not source: a megabyte each, and every one after the first holds our
# own firmware. If you want to be able to put the board back the way it came,
# keep your copy of the first dump somewhere outside the repository.
firmware/backup/

# macOS
.DS_Store
