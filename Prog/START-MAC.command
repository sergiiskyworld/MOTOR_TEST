#!/bin/bash
# Запуск стенда тяги на macOS — двойной клик по этому файлу.
#
# Откроется окно Терминала с ходом запуска; когда появится окно стенда, оно
# закроется само.
#
# Приложения-бандла (.app) здесь нет намеренно. macOS не даёт бандлу,
# лежащему в ~/Documents, выполнить соседний скрипт: запуск падал с
# «Operation not permitted» и без выдачи доступа к папке «Документы» в
# настройках приватности не работал. Файл .command запускается Терминалом,
# у которого доступ уже есть.
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/launcher/start-stand.sh"
